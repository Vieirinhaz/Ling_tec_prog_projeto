#include <stdio.h>

int main() {
    int segundosTotais, horas, minutos, segundos;

    scanf("%d", &segundosTotais);

    horas = segundosTotais / 3600;
    minutos = (segundosTotais % 3600) / 60;
    segundos = segundosTotais % 60;

    printf("%d:%d:%d\n", horas, minutos, segundos);

    return 0;
}
