#include <stdio.h>

int main() {
    int n, bits[64], i = 0;

    printf("Digite um numero (n <= 64): ");
    scanf("%d", &n);

    if (n == 0) {
        printf("0\n");
        return 0;
    }

    while (n > 0) {
        bits[i] = n % 2;
        n = n / 2;
        i++;
    }

    // imprime do ultimo bit gerado para o primeiro
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", bits[j]);
    }
    printf("\n");

    return 0;
}
