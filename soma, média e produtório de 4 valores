#include <stdio.h>

int main() {
    double v1, v2, v3, v4;
    double soma, media, produto;

    printf("Digite 4 valores: ");
    scanf("%lf %lf %lf %lf", &v1, &v2, &v3, &v4);

    soma = v1 + v2 + v3 + v4;
    media = soma / 4.0;
    produto = v1 * v2 * v3 * v4;

    printf("Soma: %.2f\n", soma);
    printf("Media: %.2f\n", media);
    printf("Produto: %.2f\n", produto);

    return 0;
}
